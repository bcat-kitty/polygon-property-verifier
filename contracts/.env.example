# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Polygon Amoy RPC URL. Default public endpoint works but rate-limits.
# For production use, sign up for a free Alchemy or Infura key.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# 64-hex private key of the wallet that will deploy the contract.
# MUST start with 0x. MUST be a dedicated testnet wallet, never one holding real funds.
PRIVATE_KEY=0xREPLACE_ME_WITH_YOUR_TEST_WALLET_PRIVATE_KEY
